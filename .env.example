# Jork - Solana's Autonomous Build Engine
# Copy to .env and fill in your values, or run: npm run setup

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_user_id_here

# AI Provider: anthropic, zai, openai, gemini, claude-cli
LLM_PROVIDER=anthropic
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=
# LLM_MODEL=

# Solana
SOLANA_CLUSTER=devnet
# SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Agent
JORK_NAME=Jork
JORK_WORKSPACE=./workspace

# Intervals (ms)
THINK_INTERVAL=300000
HEARTBEAT_INTERVAL=30000
POLL_INTERVAL=3000
INVOKE_TIMEOUT=900000
MAX_TURNS=150
